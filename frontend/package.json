{
  "name": "noteblocktool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "eslint . --fix && prettier --write .",
    "format:check": "eslint . && prettier --check .",
    "check": "npm run format:check && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@lucide/svelte": "1.70.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tsconfig/svelte": "5.0.9",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.72.2",
    "bowser": "2.15.0",
    "daisyui": "5.7.50",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "ringbuf.js": "0.4.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
